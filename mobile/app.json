{
  "expo": {
    "name": "Campo App",
    "slug": "campo-app",
    "version": "0.2.0",
    "scheme": "campo",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#081225"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campoapp.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Campo App usa tu ubicacion para centrar el mapa y registrar operaciones sobre los lotes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#081225"
      },
      "package": "com.campoapp.mobile",
      "config": { "googleMaps": { "apiKey": "AIzaSyBPUksNK7ELOdVCNvA82KduUm4pODNJ6Oo" } },
      "permissions": ["ACCESS_FINE_LOCATION", "CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Campo App usa tu ubicacion para centrar el mapa y registrar operaciones sobre los lotes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
