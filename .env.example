# =============================================================
# Campo App — Variables de Entorno (EJEMPLO — seguro para commitear)
# Copiar este archivo como .env y completar con valores reales.
# =============================================================

# --- Base de Datos ---
DB_ROOT_PASS=change_me
DB_NAME=campo_db
DB_USER=campo_user
DB_PASS=change_me
DB_PORT=3306

# --- Backend ---
BACKEND_PORT=8080
JWT_SECRET=change_me_min_256_bits
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_BLOCK_MINUTES=15

# OAuth2
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_AZURE_TENANT=
OAUTH2_AZURE_CLIENT_ID=
OAUTH2_AZURE_CLIENT_SECRET=

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# --- Mobile ---
MOBILE_PORT=8081
EXPO_PORT_DEVTOOLS=19000
EXPO_PORT_WEB=19006
HOST_IP=192.168.1.100
