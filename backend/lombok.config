# Config de Lombok del backend.
# Feature 73: al agregarse un segundo bean RestClient (gbifRestClient) ademas de
# openMeteoRestClient, la inyeccion por campo con @Qualifier de ClimaServiceImpl
# quedaba ambigua porque @RequiredArgsConstructor NO copia @Qualifier al
# parametro del constructor generado. Con esto, Lombok propaga @Qualifier (y
# @Value) a los constructores, respetando la resolucion por nombre de bean.
config.stopBubbling = true
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
